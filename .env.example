# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Usados apenas pelo script "npm run seed" (conta que já foi promovida a síndico).
SEED_SINDICO_EMAIL=
SEED_SINDICO_SENHA=
